// SPH3D.compute
#pragma kernel ClearGrid
#pragma kernel BuildGrid
#pragma kernel ComputeDensityPressure
#pragma kernel ComputeForces
#pragma kernel Integrate

// ----------------------
// Simulation params
// ----------------------
uint _ParticleCount;

float _TimeStep;
float3 _GravityLocal; // gravity expressed in tank-local space

float _RestDensity;
float _GasConstant;
float _Viscosity;
float _SmoothingRadius;

float3 _BoundsMinLocal; // tank-local AABB bounds
float3 _BoundsMaxLocal;
float _BoundaryDamping; // restitution multiplier (0..1 recommended)

float _Poly6Constant;
float _SpikyGradConstant;
float _ViscLapConstant;
float _ParticleMass;
float _ParticleRadius;

// Tank transform (for rendering only)
float4x4 _LocalToWorld; // tank local -> world

// ----------------------
// Grid (3D) for neighbor search (in tank-local space)
// ----------------------
uint3 _GridSize;
float3 _GridOriginLocal;
float _CellSize;
uint _MaxParticlesPerCell;

RWStructuredBuffer<uint> _CellCounts;
RWStructuredBuffer<uint> _CellIndices;

// ----------------------
// Optional box colliders (in tank-local space)
// Each box uses 4 float4s:
// 0: center.xyz, half.x
// 1: axisX.xyz, half.y
// 2: axisY.xyz, half.z
// 3: axisZ.xyz, unused
// ----------------------
StructuredBuffer<float4> _Boxes;
uint _BoxCount;

// ----------------------
// Particle data
// ----------------------
struct ParticleData
{
    float4 pos; // xyz = position in tank-local space
    float4 vel; // xyz = velocity in tank-local space
    float4 force; // xyz = force accumulator
    float density;
    float pressure;
    float2 pad;
};

RWStructuredBuffer<ParticleData> _Particles;

// Render positions (world space)
RWStructuredBuffer<float3> _Positions;

// ----------------------
// Helpers
// ----------------------
uint CellIndexFromCoord(uint3 c)
{
    return c.x + c.y * _GridSize.x + c.z * (_GridSize.x * _GridSize.y);
}

uint3 CellCoordFromPos(float3 pLocal)
{
    float3 rel = (pLocal - _GridOriginLocal) / _CellSize;
    int cx = (int) floor(rel.x);
    int cy = (int) floor(rel.y);
    int cz = (int) floor(rel.z);

    cx = clamp(cx, 0, (int) _GridSize.x - 1);
    cy = clamp(cy, 0, (int) _GridSize.y - 1);
    cz = clamp(cz, 0, (int) _GridSize.z - 1);

    return (uint3) uint3(cx, cy, cz);
}

// 3D kernels
float Poly6(float r, float h)
{
    // W(r,h) = 315/(64*pi*h^9) * (h^2 - r^2)^3   for 0<=r<=h
    if (r < 0.0 || r > h)
        return 0.0;
    float h2 = h * h;
    float term = h2 - r * r;
    return _Poly6Constant * term * term * term;
}

float3 SpikyGrad(float3 rvec, float r, float h)
{
    // ∇W = -45/(pi*h^6) * (h - r)^2 * rhat   for 0<r<h
    if (r <= 0.0 || r >= h)
        return float3(0.0, 0.0, 0.0);
    float term = (h - r);
    float k = _SpikyGradConstant * term * term;
    return k * (rvec / r);
}

float ViscLaplacian(float r, float h)
{
    // ∇^2 W = 45/(pi*h^6) * (h - r)   for 0<=r<=h
    if (r < 0.0 || r > h)
        return 0.0;
    return _ViscLapConstant * (h - r);
}

float3 ClosestPointOnOBB(float3 p, float3 c, float3 ax, float3 ay, float3 az, float3 halfExtents)
{
    float3 d = p - c;

    float x = clamp(dot(d, ax), -halfExtents.x, halfExtents.x);
    float y = clamp(dot(d, ay), -halfExtents.y, halfExtents.y);
    float z = clamp(dot(d, az), -halfExtents.z, halfExtents.z);

    return c + ax * x + ay * y + az * z;
}
// ----------------------
// Kernels
// ----------------------
[numthreads(256, 1, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    uint cellCount = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id.x >= cellCount)
        return;
    _CellCounts[id.x] = 0;
}

[numthreads(256, 1, 1)]
void BuildGrid(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float3 p = _Particles[i].pos.xyz; // tank-local
    uint3 c = CellCoordFromPos(p);
    uint cellIndex = CellIndexFromCoord(c);

    uint offset;
    InterlockedAdd(_CellCounts[cellIndex], 1, offset);

    if (offset < _MaxParticlesPerCell)
    {
        _CellIndices[cellIndex * _MaxParticlesPerCell + offset] = i;
    }
}

[numthreads(256, 1, 1)]
void ComputeDensityPressure(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    ParticleData pi = _Particles[i];
    float3 posi = pi.pos.xyz;

    uint3 cell = CellCoordFromPos(posi);
    float sumW = 0.0;

    float h = _SmoothingRadius;
    float h2 = h * h;

    [unroll]
    for (int dz = -1; dz <= 1; dz++)
    {
        [unroll]
        for (int dy = -1; dy <= 1; dy++)
        {
            [unroll]
            for (int dx = -1; dx <= 1; dx++)
            {
                int nx = (int) cell.x + dx;
                int ny = (int) cell.y + dy;
                int nz = (int) cell.z + dz;

                if (nx < 0 || ny < 0 || nz < 0 ||
                    nx >= (int) _GridSize.x || ny >= (int) _GridSize.y || nz >= (int) _GridSize.z)
                    continue;

                uint nCellIndex = (uint) nx + (uint) ny * _GridSize.x + (uint) nz * (_GridSize.x * _GridSize.y);
                uint count = min(_CellCounts[nCellIndex], _MaxParticlesPerCell);

                for (uint k = 0; k < count; k++)
                {
                    uint j = _CellIndices[nCellIndex * _MaxParticlesPerCell + k];

                    float3 posj = _Particles[j].pos.xyz;
                    float3 d = posi - posj;
                    float r2 = dot(d, d);
                    if (r2 >= h2)
                        continue;

                    float r = sqrt(max(r2, 1e-12));
                    sumW += Poly6(r, h);
                }
            }
        }
    }

    float density = max(_ParticleMass * sumW, 1e-5);
    float pressure = max(_GasConstant * (density - _RestDensity), 0.0);

    pi.density = density;
    pi.pressure = pressure;
    _Particles[i] = pi;
}

[numthreads(256, 1, 1)]
void ComputeForces(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    ParticleData pi = _Particles[i];
    float3 posi = pi.pos.xyz;
    float3 veli = pi.vel.xyz;

    uint3 cell = CellCoordFromPos(posi);

    float3 fPressure = float3(0.0, 0.0, 0.0);
    float3 fVisc = float3(0.0, 0.0, 0.0);

    float h = _SmoothingRadius;
    float h2 = h * h;

    [unroll]
    for (int dz = -1; dz <= 1; dz++)
    {
        [unroll]
        for (int dy = -1; dy <= 1; dy++)
        {
            [unroll]
            for (int dx = -1; dx <= 1; dx++)
            {
                int nx = (int) cell.x + dx;
                int ny = (int) cell.y + dy;
                int nz = (int) cell.z + dz;

                if (nx < 0 || ny < 0 || nz < 0 ||
                    nx >= (int) _GridSize.x || ny >= (int) _GridSize.y || nz >= (int) _GridSize.z)
                    continue;

                uint nCellIndex = (uint) nx + (uint) ny * _GridSize.x + (uint) nz * (_GridSize.x * _GridSize.y);
                uint count = min(_CellCounts[nCellIndex], _MaxParticlesPerCell);

                for (uint k = 0; k < count; k++)
                {
                    uint j = _CellIndices[nCellIndex * _MaxParticlesPerCell + k];
                    if (j == i)
                        continue;

                    ParticleData pj = _Particles[j];

                    float3 rvec = posi - pj.pos.xyz;
                    float r2 = dot(rvec, rvec);
                    if (r2 <= 1e-12 || r2 >= h2)
                        continue;

                    float r = sqrt(r2);

                    // Pressure
                    float3 gradW = SpikyGrad(rvec, r, h);
                    float term = (pi.pressure / (pi.density * pi.density)) +
                                 (pj.pressure / (pj.density * pj.density));
                    fPressure += -_ParticleMass * term * gradW;

                    // Viscosity
                    float lap = ViscLaplacian(r, h);
                    float3 dv = pj.vel.xyz - veli;
                    fVisc += _Viscosity * _ParticleMass * (dv / pj.density) * lap;
                }
            }
        }
    }

    float3 fGravity = _ParticleMass * _GravityLocal;

    pi.force.xyz = fPressure + fVisc + fGravity;
    _Particles[i] = pi;
}

[numthreads(256, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    ParticleData p = _Particles[i];

    float3 pos = p.pos.xyz;
    float3 vel = p.vel.xyz;

    float3 acc = p.force.xyz / p.density;
    vel += acc * _TimeStep;
    pos += vel * _TimeStep;

    // --- Tank-local AABB boundary (keeps particles inside tank volume) ---
    if (pos.x < _BoundsMinLocal.x)
    {
        pos.x = _BoundsMinLocal.x;
        vel.x *= _BoundaryDamping;
    }
    if (pos.x > _BoundsMaxLocal.x)
    {
        pos.x = _BoundsMaxLocal.x;
        vel.x *= _BoundaryDamping;
    }

    if (pos.y < _BoundsMinLocal.y)
    {
        pos.y = _BoundsMinLocal.y;
        vel.y *= _BoundaryDamping;
    }
    if (pos.y > _BoundsMaxLocal.y)
    {
        pos.y = _BoundsMaxLocal.y;
        vel.y *= _BoundaryDamping;
    }

    if (pos.z < _BoundsMinLocal.z)
    {
        pos.z = _BoundsMinLocal.z;
        vel.z *= _BoundaryDamping;
    }
    if (pos.z > _BoundsMaxLocal.z)
    {
        pos.z = _BoundsMaxLocal.z;
        vel.z *= _BoundaryDamping;
    }

    // --- Optional BoxCollider-style collisions (OBB in tank-local space) ---
    float pr = _ParticleRadius;
    for (uint bi = 0; bi < _BoxCount; ++bi)
    {
        uint baseIdx = bi * 4;

        float4 b0 = _Boxes[baseIdx + 0];
        float4 b1 = _Boxes[baseIdx + 1];
        float4 b2 = _Boxes[baseIdx + 2];
        float4 b3 = _Boxes[baseIdx + 3];

        float3 c = b0.xyz;
        float3 halfExtents = float3(b0.w, b1.w, b2.w);

        float3 ax = b1.xyz;
        float3 ay = b2.xyz;
        float3 az = b3.xyz;

        float3 closest = ClosestPointOnOBB(pos, c, ax, ay, az, halfExtents);

        float3 dir = pos - closest;
        float dist2 = dot(dir, dir);

        if (dist2 < pr * pr)
        {
            float dist = sqrt(max(dist2, 1e-12));
            float3 n = dir / dist;

            pos = closest + n * pr;
            vel = reflect(vel, n) * _BoundaryDamping;
        }
    }

    // store back
    p.pos.xyz = pos;
    p.vel.xyz = vel;
    p.force.xyz = float3(0.0, 0.0, 0.0);
    _Particles[i] = p;

    // output world position for rendering
    float4 world = mul(_LocalToWorld, float4(pos, 1.0));
    _Positions[i] = world.xyz;
}